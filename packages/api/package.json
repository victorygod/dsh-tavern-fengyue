{
  "name": "dsh-tavern-fengyue-api",
  "description": "Tavern Remote owner: session creation, card library imports, workspace tree edits, saves, and card state for the tavern UI",
  "version": "0.1.0-rc.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-gateway"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victorygod/dsh-tavern-fengyue.git",
    "directory": "packages/api"
  },
  "homepage": "https://github.com/victorygod/dsh-tavern-fengyue#readme",
  "bugs": {
    "url": "https://github.com/victorygod/dsh-tavern-fengyue/issues"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "sillytavern",
    "rpg"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-gateway": ">=0.1.5-rc.1 <0.2",
    "@deepseek-ai/dsh-session": ">=0.1.5-rc.1 <0.2",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.5-rc.1 <0.2",
    "dsh-tavern-fengyue-engine": "workspace:*"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.5-rc.1 <0.2"
  }
}
