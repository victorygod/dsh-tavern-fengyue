{
  "name": "dsh-tavern-fengyue-ui",
  "description": "Tavern browser surface: the full-screen tavern UI with conversation, card library, editor, and saves",
  "version": "0.1.0-rc.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace",
        "dsh-tavern-fengyue-api"
      ],
      "platform": "web",
      "external": []
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victorygod/dsh-tavern-fengyue.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/victorygod/dsh-tavern-fengyue#readme",
  "bugs": {
    "url": "https://github.com/victorygod/dsh-tavern-fengyue/issues"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "sillytavern",
    "rpg"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.5-rc.1 <0.2",
    "@deepseek-ai/dsh-api-session-controller": ">=0.1.5-rc.1 <0.2",
    "@deepseek-ai/dsh-client-locale": ">=0.1.5-rc.1 <0.2",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.5-rc.1 <0.2",
    "@deepseek-ai/dsh-client-ui-model-selection": ">=0.1.5-rc.1 <0.2",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.5-rc.1 <0.2",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.5-rc.1 <0.2",
    "@deepseek-ai/dsh-client-ui-session": ">=0.1.5-rc.1 <0.2",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.5-rc.1 <0.2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.5-rc.1 <0.2",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.1.5-rc.1 <0.2",
    "@deepseek-ai/dsh-session": ">=0.1.5-rc.1 <0.2",
    "@deepseek-ai/dsh-session-stats": ">=0.1.5-rc.1 <0.2",
    "@deepseek-ai/dsh-token-meter": ">=0.1.5-rc.1 <0.2",
    "@deepseek-ai/dsh-util-crypto": ">=0.1.5-rc.1 <0.2",
    "dsh-tavern-fengyue-api": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "dsh-tavern-fengyue-client-runtime": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "dompurify": "^3.4.15",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0"
  }
}
