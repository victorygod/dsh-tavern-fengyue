# Copy this file to `.env` (git-ignored). `bin/dev.mjs` loads repo-root `.env`
# on start and forwards the variables to the dsh host process — equivalent to
# setting them in the shell that launches the tavern. See README "First Play".

# LLM service credentials (DeepSeek API key).
DEEPSEEK_API_KEY=

# Optional: self-hosted / proxied endpoint (any OpenAI-compatible provider).
# DEEPSEEK_BASE_URL=https://api.deepseek.com
